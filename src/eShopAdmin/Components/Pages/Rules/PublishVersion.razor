@page "/rules/{RuleTypeId}/versions/{Id:guid}/publish"
@attribute [Authorize(Policy = AdminPolicies.Publish)]
@using eShopAdmin.BusinessRules
@using eShopAdmin.Rules
@inject BusinessRulesClient Client
@inject NavigationManager Navigation

@if (ruleType is not null && version is not null)
{
    <PageTitle>Publish v@(version.VersionNumber) · @ruleType.Id @ruleType.Name · eShopAdmin</PageTitle>

    <p class="breadcrumb"><a href="rules">All rules</a> / <a href="@HistoryUrl">@ruleType.Name</a></p>
    <h1>@PageHeading</h1>
    <p>@ruleType.Id @ruleType.Name</p>

    @if (HasAlert)
    {
        <div id="publish-error-summary" class="error-summary" role="alert" tabindex="-1" data-focus-on-load>
            <h2>The version wasn't published</h2>
            @if (guardDetail is not null)
            {
                <p>@PublishCopy.Guard</p>
                <p>@guardDetail</p>
            }
            @foreach (var message in messages)
            {
                <p>@message</p>
            }
            @if (reasonError is not null)
            {
                <ul>
                    <li><a href="#@ReasonId">@reasonError</a></li>
                </ul>
            }
        </div>
    }

    @if (!versionIsDraft && !showForm && !HasAlert)
    {
        <p class="note">@PublishCopy.Conflict("it is no longer a draft.")</p>
    }

    <h2>What changes</h2>
    <table class="data-table">
        <caption>Current and new settings for @ruleType.Id @ruleType.Name</caption>
        <thead>
            <tr>
                <th scope="col"><span class="visually-hidden">Setting</span></th>
                <th scope="col">Current</th>
                <th scope="col">New</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <th scope="row">Version</th>
                <td>@(summary.Current is { } current ? $"v{current.VersionNumber}" : "—")</td>
                <td>@($"v{version.VersionNumber}")</td>
            </tr>
            <tr>
                <th scope="row">Value</th>
                <td>@(summary.Current is { } currentValue ? ParameterSummary.Describe(ruleType.Id, currentValue.Parameters) : DefaultCopy)</td>
                <td>@ParameterSummary.Describe(ruleType.Id, version.Parameters)</td>
            </tr>
            <tr>
                <th scope="row">Effective (UTC)</th>
                <td>@(summary.Current is { } currentWindow ? Window(currentWindow) : "—")</td>
                <td>@Window(version)</td>
            </tr>
        </tbody>
    </table>

    @if (startsInPast)
    {
        <p class="callout">@PublishCopy.PastStart</p>
    }

    @if (ruleType.AffectsPrice)
    {
        <p class="callout">@PublishCopy.PriceWarning</p>
    }

    @if (showForm && editContext is not null && Input is not null)
    {
        <EditForm EditContext="editContext" FormName="@PublishForm" OnSubmit="HandleSubmitAsync" Enhance novalidate>
            @if (overrideShown)
            {
                <div class="field">
                    <label for="@ReasonId">@PublishCopy.ReasonLabel</label>
                    <InputTextArea id="@ReasonId" name="@ReasonField" @bind-Value="Input.Reason" rows="4" maxlength="500" required
                                   aria-describedby="@(reasonError is null ? null : ReasonErrorId)" />
                    <ValidationMessage For="() => Input.Reason" id="@ReasonErrorId" />
                </div>
            }

            <div class="form-actions">
                <button type="submit">@(overrideShown ? "Publish anyway" : "Publish")</button>
                <a href="@HistoryUrl">Cancel</a>
            </div>
        </EditForm>
    }
    else
    {
        <p><a href="@HistoryUrl">Back to history</a></p>
    }
}

@code {
    private const string PublishForm = "publish";
    private const string ReasonField = "Input.Reason";
    private const string ReasonId = "publish-reason";
    private const string ReasonErrorId = "publish-reason-error";
    private const string DefaultCopy = "Built-in default";
    private const string ReasonRequiredCopy = "Enter a reason for publishing anyway.";

    private RuleTypeDto? ruleType;
    private RuleVersionDto? version;
    private RuleStatusSummary summary = new(null, null, 0);
    private bool versionIsDraft;
    private bool startsInPast;
    private bool showForm;
    private bool overrideShown;
    private string? guardDetail;
    private string? reasonError;
    private EditContext? editContext;
    private ValidationMessageStore? messageStore;
    private readonly List<string> messages = [];

    [Parameter]
    public string RuleTypeId { get; set; } = string.Empty;

    [Parameter]
    public Guid Id { get; set; }

    // The posted form, bound by the framework. It is null on GET.
    [SupplyParameterFromForm(FormName = PublishForm)]
    private PublishInput? Input { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private bool HasAlert => guardDetail is not null || messages.Count > 0 || reasonError is not null;

    private string HistoryUrl => $"rules/{Uri.EscapeDataString(RuleTypeId)}";

    private string PageHeading => $"Publish {ruleType?.Name} v{version?.VersionNumber}";

    protected override async Task OnInitializedAsync()
    {
        var ct = HttpContext?.RequestAborted ?? default;
        ruleType = (await Client.GetRuleTypesAsync(ct))
            .FirstOrDefault(t => string.Equals(t.Id, RuleTypeId, StringComparison.Ordinal));
        if (ruleType is null)
        {
            // Sets the 404 status and renders the router's NotFoundPage.
            Navigation.NotFound();
            return;
        }

        var versions = await Client.GetVersionsAsync(ruleType.Id, ct);
        version = versions.FirstOrDefault(v => v.Id == Id);
        if (version is null)
        {
            Navigation.NotFound();
            return;
        }

        var now = DateTimeOffset.UtcNow;
        summary = RuleStatusSummary.From(versions, now);
        versionIsDraft = version.Status == RuleVersionStatus.Draft;
        startsInPast = version.EffectiveFrom <= now;

        // A submit must reach its handler even when the version stopped being a draft in the meantime (a double
        // submit), so the form is rendered on a POST and the API's answer is what the user sees.
        showForm = versionIsDraft || HttpMethods.IsPost(HttpContext?.Request.Method ?? string.Empty);
        Input ??= new PublishInput();
        editContext = new EditContext(Input);
        messageStore = new ValidationMessageStore(editContext);
    }

    private void ShowReasonError(string message)
    {
        reasonError = message;
        messageStore!.Add(editContext!.Field(nameof(PublishInput.Reason)), message);
        editContext.NotifyValidationStateChanged();
    }

    private async Task HandleSubmitAsync()
    {
        if (ruleType is null || version is null || Input is null || messageStore is null)
        {
            return;
        }

        messageStore.Clear();
        var ct = HttpContext?.RequestAborted ?? default;

        // The reason box only exists on the override form, so its presence in the post says the guard was shown.
        var form = HttpContext?.Request.Form;
        overrideShown = form?.ContainsKey(ReasonField) == true;
        Input.Reason = overrideShown ? form![ReasonField].ToString() : null;
        var reason = PublishCopy.NormalizeReason(Input.Reason);

        if (overrideShown && reason is null)
        {
            ShowReasonError(ReasonRequiredCopy);
            return;
        }

        var result = await Client.PublishAsync(version.Id, reason, ct);
        switch (result)
        {
            case PublishResult.Published published:
                Navigation.NavigateTo($"{HistoryUrl}?status={Uri.EscapeDataString(PublishCopy.Published(published.SnapshotVersion))}");
                break;
            case PublishResult.V1ClientsActive v1:
                overrideShown = true;
                guardDetail = v1.Detail;
                break;
            case PublishResult.InvalidOverrideReason invalid:
                overrideShown = true;
                ShowReasonError(invalid.Detail);
                break;
            case PublishResult.GuardUnavailable:
                messages.Add(PublishCopy.GuardUnavailable);
                break;
            case PublishResult.ConcurrentPublish:
                messages.Add(PublishCopy.ConcurrentPublish);
                break;
            case PublishResult.Conflict conflict:
                messages.Add(PublishCopy.Conflict(conflict.Detail));
                showForm = false;
                break;
            case PublishResult.Forbidden:
                Navigation.NavigateTo("/access-denied");
                break;
            default:
                // The version or the rule type is gone.
                Navigation.NotFound();
                break;
        }
    }

    private static string Window(RuleVersionDto v) =>
        $"{RuleStatusSummary.FormatUtc(v.EffectiveFrom)} to {(v.EffectiveTo is { } to ? RuleStatusSummary.FormatUtc(to) : "no end")}";

    public sealed class PublishInput
    {
        public string? Reason { get; set; }
    }
}
